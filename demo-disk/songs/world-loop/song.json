    "id": "CC0-1.0",
    "credit": "Vasily Kazantsev (PT/FM)",
    "url": "https://creativecommons.org/publicdomain/zero/1.0/"
  },
  "tempo": 120,
  "ticks_a_row": 6,
  "rows_a_beat": 4,
  "swing": 50,
  "at_the_end": "loop",
  "loop_from": 0,
  "slides": "linear",
  "fast_volume_slides": false,
  "global_volume": 60,
  "positions": [57],
  "mixer": [
    {"level": 127, "pan": 128, "duck": 0, "chorus": 0, "delay": 0, "reverb": 0},
    {"level": 93, "pan": 150, "duck": 0, "chorus": 0, "delay": 0, "reverb": 20},
    {"level": 79, "pan": 128, "duck": 0, "chorus": 0, "delay": 0, "reverb": 0},
    {"level": 94, "pan": 104, "duck": 0, "chorus": 0, "delay": 30, "reverb": 40},
    {"level": 90, "pan": 150, "duck": 0, "chorus": 0, "delay": 0, "reverb": 20},
    {"level": 90, "pan": 150, "duck": 0, "chorus": 0, "delay": 0, "reverb": 20}
  ],
  "fx": {

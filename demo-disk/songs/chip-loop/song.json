    "id": "CC0-1.0",
    "credit": "Vasily Kazantsev (PT/FM)",
    "url": "https://creativecommons.org/publicdomain/zero/1.0/"
  },
  "tempo": 125,
  "ticks_a_row": 6,
  "rows_a_beat": 4,
  "swing": 50,
  "at_the_end": "loop",
  "loop_from": 0,
  "slides": "linear",
  "fast_volume_slides": false,
  "global_volume": 50,
  "positions": [44, 45],
  "mixer": [
    {"level": 125, "pan": 128, "duck": 0, "chorus": 0, "delay": 0, "reverb": 0},
    {"level": 83, "pan": 152, "duck": 0, "chorus": 0, "delay": 0, "reverb": 0},
    {"level": 127, "pan": 128, "duck": 0, "chorus": 0, "delay": 0, "reverb": 0},
    {"level": 87, "pan": 104, "duck": 0, "chorus": 0, "delay": 0, "reverb": 0},
    {"level": 86, "pan": 152, "duck": 0, "chorus": 0, "delay": 0, "reverb": 0},
    {"level": 82, "pan": 152, "duck": 0, "chorus": 0, "delay": 0, "reverb": 0}
  ],
  "fx": {
    "routing": "global",
    "chain": ["GATE", "FILTER", "LO-FI", "SENDS", "CHORUS", "DELAY", "REVERB", "DRIVE", "LIMITER"],

{
  "format": "demo-disk/song",
  "version": 2,
  "name": "ACID LOOP",
  "what": "Acid house, A minor, 128 BPM. A DJ loop of the TB-303: its line with accents and slides, the CUTOFF opening over four bars and closing over four; the JUNO-106's 909 Kick, hats and claps. An intro first, played once: the drums alone for four bars, then the 303 coming in nearly closed",
  "license": {
    "id": "CC0-1.0",
    "credit": "Vasily Kazantsev (PT/FM)",
    "url": "https://creativecommons.org/publicdomain/zero/1.0/"
  },
  "tempo": 128,
  "ticks_a_row": 6,
  "rows_a_beat": 4,
  "swing": 50,
  "at_the_end": "loop",
  "loop_from": 1,
  "slides": "linear",
  "fast_volume_slides": false,
  "global_volume": 50,
  "positions": [40, 41],
  "mixer": [
    {"level": 127, "pan": 128, "duck": 0, "chorus": 0, "delay": 0, "reverb": 0},
    {"level": 108, "pan": 156, "duck": 0, "chorus": 0, "delay": 15, "reverb": 0},
    {"level": 80, "pan": 128, "duck": 0, "chorus": 0, "delay": 30, "reverb": 0},
    {"level": 108, "pan": 120, "duck": 0, "chorus": 0, "delay": 0, "reverb": 30},
    {"level": 59, "pan": 156, "duck": 0, "chorus": 0, "delay": 15, "reverb": 0}
  ],
  "fx": {
    "routing": "sends",
    "chain": ["GATE", "FILTER", "LO-FI", "SENDS", "CHORUS", "DELAY", "REVERB", "DRIVE", "LIMITER"],
    "gate": {"on": false, "pattern": 1, "rate": "1/16", "depth": 100, "smooth": 20},
    "filter": {"on": false, "cut": "OFF", "reso": 30},
    "drive": {"on": false, "drive": 30, "tone": 50},
    "lofi": {"on": false, "bits": 8, "rate": 22, "dust": 20},
    "chorus": {"on": false, "mode": "I", "rate": 30, "depth": 50, "mix": 50},
    "delay": {"on": true, "time": "1/8.", "feedback": 40, "tone": 50, "ping_pong": true, "mix": 30},
    "reverb": {"on": true, "size": 60, "damp": 40, "pre_delay": 10, "mix": 30},
    "limiter": {"on": true, "ceiling": -1, "release": 100},
    "duck": {"on": false, "source": 1, "depth": 60, "release": 150},
    "metronome": {"on": false, "tempo": "FOLLOW", "beats_a_bar": 4, "sound": "BEEP", "level": 60}
  },
  "patterns": "patterns.json"
